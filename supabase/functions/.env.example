# this api key is for local edge funciton instances only
# if key changes, write it here and update key on prod with 
# supabase secrets set --env-file supabase/functions/.env
# from top level directory
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# these are generated by onshape classroom  and count to
# that api budget
ONSHAPE_WEBHOOK_SECRET_PRIMARY=
ONSHAPE_WEBHOOK_SECRET_SECONDARY=