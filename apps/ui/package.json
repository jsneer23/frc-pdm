{
  "name": "ui",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/router-cli": "1.167.41",
    "@tanstack/router-plugin": "1.168.43",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
